</main>

<footer class="footer">
  <div class="contenedor">
    <div class="footer-grid">
      <div>
        <a href="/" class="logo"><img src="/img/logo.webp" alt="<%= cfg.nombre_sitio %>" width="114" height="52"></a>
        <p>Merchandising y diseño para empresas. No es un regalo, es estrategia.</p>
        <div class="redes">
          <a href="https://wa.me/<%= cfg.whatsapp %>" target="_blank" rel="noopener" aria-label="WhatsApp"><svg><use href="#i-wpp"/></svg></a>
          <% if (cfg.instagram) { %><a href="<%= cfg.instagram %>" target="_blank" rel="noopener" aria-label="Instagram"><svg><use href="#i-ig"/></svg></a><% } %>
          <% if (cfg.linkedin) { %><a href="<%= cfg.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn"><svg><use href="#i-in"/></svg></a><% } %>
        </div>
      </div>
      <div>
        <h4>Arke</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/productos">Productos</a></li>
          <li><a href="/proceso-de-compra">Proceso de compra</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h4>Categorías</h4>
        <ul>
          <% categoriasMenu.slice(0, 8).forEach(function (c) { %><li><a href="<%= urlCategoria(c) %>"><%= c.nombre %></a></li><% }) %>
        </ul>
      </div>
      <div>
        <h4>Contacto</h4>
        <ul>
          <li><a href="https://wa.me/<%= cfg.whatsapp %>" target="_blank" rel="noopener">+<%= cfg.whatsapp %></a></li>
          <li><a href="tel:<%= cfg.telefono %>"><%= cfg.telefono %></a></li>
          <li><a href="mailto:<%= cfg.email %>"><%= cfg.email %></a></li>
        </ul>
      </div>
    </div>
    <div class="copy">© <%= cfg.titulo_sitio %> <%= new Date().getFullYear() %>. Todos los derechos reservados.</div>
  </div>
</footer>

<a class="wpp-flotante" href="https://wa.me/<%= cfg.whatsapp %>?text=<%= encodeURIComponent(cfg.mensaje_whatsapp) %>" target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
  <svg><use href="#i-wpp"/></svg>
</a>

<script src="/js/app.js" defer></script>
</body>
</html>
